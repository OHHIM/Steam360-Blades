(() => {
  if (window.__x360Store) return;
  window.__x360Store = true;
  const tick = new Audio('https://steamloopback.host/sounds/x360_focus.wav');
  tick.preload = 'auto';
  tick.volume = 0.6;
  let last = 0, current = null;
  function play(target) {
    const now = performance.now();
    if (!target || target === current || now - last < 60) return;
    current = target;
    last = now;
    try { tick.currentTime = 0; tick.play().catch(() => {}); } catch {  }
  }
  document.addEventListener('focusin', event => play(event.target), true);
  const RGB = /rgba?\((\d+), (\d+), (\d+)(?:, ([\d.]+))?\)/;
  function parse(value) {
    const m = RGB.exec(value || '');
    return m ? { r: +m[1], g: +m[2], b: +m[3], a: m[4] === undefined ? 1 : +m[4] } : null;
  }
  const isNavy = c => c && c.a >= 0.25 && (c.r + c.g + c.b) > 12 && (
    (Math.max(c.r, c.g, c.b) <= 130 && c.b >= c.r && c.b >= c.g - 6 && (c.b - c.r >= 5 || c.b < 60)) ||
    (c.a >= 0.5 && Math.max(c.r, c.g, c.b) <= 72));
  const isLight = c => c && c.a >= 0.6 && Math.min(c.r, c.g, c.b) >= 190;
  const isBarBlue = c => c && c.a >= 0.5 && c.b >= 120 && c.b - c.r >= 60 && c.b >= c.g;
  const isBlue = c => c && c.a >= 0.5 && c.b >= 170 && c.r <= 130 && c.g >= 90 && c.b - c.r >= 80;
  const isDim = c => c && c.a >= 0.5 && Math.max(c.r, c.g, c.b) >= 85 && Math.max(c.r, c.g, c.b) <= 205 && Math.max(c.r, c.g, c.b) - Math.min(c.r, c.g, c.b) <= 70;
  function floating(el, cs) {
    for (let node = el, style = cs, depth = 0; node && node !== document.body && depth < 4; node = node.parentElement, depth++) {
      style = depth ? getComputedStyle(node) : cs;
      if ((style.position === 'absolute' || style.position === 'fixed') && (+style.zIndex >= 2 || node.getAttribute('role') === 'menu' || node.getAttribute('role') === 'dialog')) return true;
    }
    return false;
  }
  function classify(el) {
    if (el.id === 'x360-defs' || el.closest?.('[data-x360-skip]')) return;
    const cs = getComputedStyle(el);
    if (cs.display === 'none') return;
    let bg = null;
    const image = cs.backgroundImage;
    if (el.matches('html, body, .responsive_page_frame, .responsive_page_content, .responsive_page_template_content, #application_root')) return;
    if (image && image.includes('url(') && !el.hasAttribute('data-x360-bg')) {
      const box = el.getBoundingClientRect();
      if (box.width >= innerWidth * 0.9 && box.height >= innerHeight * 1.5) { el.setAttribute('data-x360-bg', 'backdrop'); return; }
    }
    if (image && image !== 'none') {
      if (!image.includes('url(') && image.includes('gradient')) bg = parse(image);
    } else {
      bg = parse(cs.backgroundColor);
    }
    if (bg && !el.hasAttribute('data-x360-bg')) {
      const rect = el.getBoundingClientRect();
      if (rect.height >= 3 && rect.height <= 14 && rect.width >= 6 && isBarBlue(bg) && !el.children.length) {
        el.setAttribute('data-x360-bg', 'fill');
      } else if (isLight(bg) && rect.width >= 30 && rect.width <= 420 && rect.height >= 16 && rect.height <= 90 && !el.querySelector('img, video, picture, input') && (el.textContent || '').trim()) {
        el.setAttribute('data-x360-bg', 'chip');
      } else if (rect.top + scrollY <= 4 && rect.height >= 30 && rect.height <= 90 && rect.width >= innerWidth * 0.9 && el !== document.body) {
        el.setAttribute('data-x360-bg', 'bar');
        el.style.setProperty('--x360-bar-h', Math.round(rect.height) + 'px');
      } else if (isNavy(bg) && floating(el, cs)) {
        el.setAttribute('data-x360-bg', 'solid');
      } else if (isBlue(bg)) {
        const r = el.getBoundingClientRect();
        el.setAttribute('data-x360-bg', r.width <= 520 && r.height <= 90 ? 'plate' : 'glass');
      } else if (isNavy(bg)) {
        el.setAttribute('data-x360-bg', 'glass');
      }
    }
    if (el.childNodes.length && [...el.childNodes].some(n => n.nodeType === 3 && n.textContent.trim())) {
      const fg = parse(cs.color);
      if (isBlue(fg)) el.setAttribute('data-x360-fg', 'accent');
      else if (isDim(fg)) el.setAttribute('data-x360-fg', 'dim');
    }
  }
  function highlight(el, attr, state) {
    if (!el || el.nodeType !== 1 || el.hasAttribute(attr) || el === document.body || el.closest('[data-x360-bg="bar"], [data-x360-skip]')) return;
    setTimeout(() => {
      if (!el.isConnected || !el.matches(state)) return;
      const rect = el.getBoundingClientRect();
      if (rect.height > 260 || rect.width < 30 || el.querySelector('img, video, picture')) return;
      const cs = getComputedStyle(el);
      const image = cs.backgroundImage;
      const bg = image && image !== 'none' ? (image.includes('url(') ? null : parse(image)) : parse(cs.backgroundColor);
      if (bg && bg.a >= 0.25 && (isLight(bg) || isBlue(bg) || isNavy(bg))) el.setAttribute(attr, '');
    }, 240);
  }
  document.addEventListener('mouseover', event => highlight(event.target?.closest?.('a, button, [role="button"], [role="menuitem"], [role="tab"], [role="option"], .Focusable, .tab, li'), 'data-x360-hover', ':hover'), true);
  const seen = new WeakSet();
  let queue = [], scheduled = false;
  function enqueue(root) {
    if (!root || root.nodeType !== 1) return;
    queue.push(root);
    if (!scheduled) { scheduled = true; (window.requestIdleCallback || setTimeout)(drain, { timeout: 400 }); }
  }
  function drain(deadline) {
    scheduled = false;
    let budget = 600;
    while (queue.length && budget > 0 && (!deadline?.timeRemaining || deadline.timeRemaining() > 2 || deadline.didTimeout)) {
      const root = queue.shift();
      if (!root.isConnected) continue;
      const walker = document.createTreeWalker(root, NodeFilter.SHOW_ELEMENT);
      let el = root;
      while (el && budget > 0) {
        if (!seen.has(el)) { seen.add(el); classify(el); budget--; }
        el = walker.nextNode();
      }
      if (el) { queue.unshift(el); break; }
    }
    if (queue.length) { scheduled = true; (window.requestIdleCallback || setTimeout)(drain, { timeout: 400 }); }
  }
  function start() {
    enqueue(document.body);
    setTimeout(() => { for (const el of document.querySelectorAll('.gpfocus')) highlight(el, 'data-x360-focus', '.gpfocus'); }, 600);
    new MutationObserver(records => {
      for (const record of records) {
        if (record.type === 'attributes') {
          const el = record.target;
          if (el.classList?.contains('gpfocus') && !record.oldValue?.split(' ').includes('gpfocus')) { play(el); highlight(el, 'data-x360-focus', '.gpfocus'); }
          continue;
        }
        for (const node of record.addedNodes) enqueue(node);
      }
    }).observe(document.documentElement, { subtree: true, childList: true, attributes: true, attributeFilter: ['class'], attributeOldValue: true });
  }
  if (document.body) start();
  else document.addEventListener('DOMContentLoaded', start, { once: true });
})();
